#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
G="${GRADLE_BIN:-}"
if [[ -z "$G" ]]; then
  for c in \
    /home/ubuntu/tools/gradle-8.14.6/bin/gradle \
    /home/hatch/gradle-dist/gradle-8.14.6/bin/gradle \
    "$(command -v gradle || true)"; do
    if [[ -n "${c:-}" && -x "$c" ]]; then G="$c"; break; fi
  done
fi
[[ -n "${G:-}" && -x "$G" ]] || { echo "Gradle not found" >&2; exit 1; }
exec "$G" -p "$ROOT" "$@"
